; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Habitat Zero"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
ReserveState="*res://scripts/world/reserve_state.gd"
ReserveSimulation="*res://scripts/world/reserve_simulation.gd"
DemoSession="*res://scripts/demo/demo_session.gd"
DemoInterface="*res://scripts/demo/demo_interface.gd"
SceneTransitionManager="*res://scripts/world/scene_transition_manager.gd"
DreamFlow="*res://scripts/demo/dream_flow.gd"
DevelopmentTools="*res://scripts/demo/development_tools.gd"
SaveSystem="*res://scripts/save/save_system.gd"
GameMenus="*res://scripts/ui/game_menus.gd"
ControllerSupport="*res://scripts/input/controller_support.gd"
Soundtrack="*res://scripts/audio/soundtrack.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

